@page
@model IndexModel
@{
    ViewData["Title"] = "Produtos - Loja";
}

 
        <div class="grid produtos">


            @foreach (var product in Model.Produtos)
                {

                    <div class="card">
                        <img src="@product.Url" alt="@product.Nome" >
                        <div class="card-content">
                            <h3 class="product-name">@product.Nome</h3>
                            <p class="product-price">R$ @product.Preco</p>
                            <p class="product-stock">Em estoque: @product.Estoque</p>
                            <button class="btn-add-cart">Adicionar ao Carrinho</button>
                        </div>
                    </div>


                }
</div>




